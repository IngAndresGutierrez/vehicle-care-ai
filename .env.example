# Local PostgreSQL (docker compose). Never commit real credentials.
DATABASE_URL="postgresql://vehicle_care:vehicle_care@localhost:54329/vehicle_care?schema=public"
DATABASE_URL_TEST="postgresql://vehicle_care:vehicle_care@localhost:54329/vehicle_care_test?schema=public"

# Fase 5 — agente y API
# Firma de la sesión demo y pseudonimización de logs (mínimo 32 caracteres; NO usar estos valores fuera de local).
SESSION_SECRET="dev-only-session-secret-change-me-0123456789"
LOG_HASH_SECRET="dev-only-log-hash-secret-change-me-0123456789"
DEMO_MODE="true"
# scripted (simulación determinista, sin API key) | anthropic (requiere ANTHROPIC_API_KEY)
LLM_PROVIDER="scripted"
LLM_MODEL="claude-opus-5-5"
LLM_EFFORT="medium"
LLM_TIMEOUT_MS="30000"
LLM_SERVER_FALLBACKS="true"
AGENT_TURNS_PER_MINUTE="20"
# Límite de corridas de demo por IP cada 10 minutos (Fase 6)
DEMO_RUNS_PER_10_MIN=12
