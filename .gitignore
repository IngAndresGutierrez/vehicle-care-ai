# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env example is committed
!.env.example

# prisma generated client
/src/generated/

# secrets and keys (never commit)
*.key
*.p12
*.pfx
secrets/
.npmrc

# local databases, dumps and volumes
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
*.sql.gz
pgdata/
docker/postgres/data/

# local tool / editor config
.claude/
.idea/
.vscode/
*.log

# Playwright (Fase 6): resultados y reporte HTML se regeneran; las capturas de evidencia sí se versionan
/test-results/
/prd/reports/playwright/
/playwright/.cache/
